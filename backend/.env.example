APP_ENV=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/ghana_health
# Generate locally with: py -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_MINUTES=30
DAHL_API_KEY=
DAHL_MODEL=MiniMaxAI/MiniMax-M2.7
# Optional local development: use a local SMTP catcher such as Mailpit (host=127.0.0.1, port=1025).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
