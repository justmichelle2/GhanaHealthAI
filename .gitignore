# ============================================================
# Ghana Health Assistant — .gitignore
# ============================================================

# --- Python / virtual environment ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.env/
.venv/
backend/.venv/
pip-install.log
pip-install.err.log
scaffold.log
scaffold2.log

# --- Installer logs ---
pip-log.txt
pip-delete-this-directory.txt

# --- Python virtualenv / environments ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Node / frontend ---
node_modules/
frontend/node_modules/
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo
.pytest_cache/

# --- Build output ---
dist/
build/
frontend/dist/
frontend/build/
frontend/vite.config.js
frontend/vite.config.d.ts
*.local

# --- Vite ---
.vite/

# --- Environment / secrets ---
.env
.env.local
.env.*.local
backend/.env
frontend/.env
secrets/
*.key
*.pem
*.crt
*.pfx

# --- Uploaded patient files & local audio recordings (safety/privacy) ---
backend/uploads/
frontend/public/uploads/
**/uploads/
*.wav
*.mp3
*.m4a
*.ogg
*.webm
*.pcm
audio/
recordings/
**/recordings/
**/audio/

# --- OS ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Misc ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
